# Build output. A bare `go build ./cmd/<name>` (no -o) drops the binary in the repo
# root; ignore those names so a stray never gets committed. (Prefer `go build ./...`
# which discards, or `go build -o /tmp/<name> ./cmd/<name>`.)
/nanoclaw
/goclaw
/claude-runner
/stub-runner
/bin/
*.exe

# Local data & state (includes installed plugins under data/plugins/<name>/:
# per-host compiled binaries + plugin.yml, not committed).
/data/
*.db
*.db-wal
*.db-shm

# Secrets / local config
*.env
.env

# Editor / OS
.DS_Store
.idea/
.vscode/

# CodeGraph index
.codegraph/
